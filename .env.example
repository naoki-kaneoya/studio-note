# microCMS
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# Resend（フォーム送信）
RESEND_API_KEY=
RESEND_FROM=noreply@example.com
CONTACT_EMAIL=

# Upnow 予約リンク（直書き禁止・ここで一元管理）
NEXT_PUBLIC_UPNOW_STUDIO_URL=https://upnow.jp/note/Studio-note
NEXT_PUBLIC_UPNOW_NODA_URL=https://upnow.jp/note/noda

# サイトURL（sitemap/構造化データ用）
NEXT_PUBLIC_SITE_URL=https://example.com

# GA4
NEXT_PUBLIC_GA_ID=

# Studio note・野田小学校の直接予約（設定後に受付を開始）
# docs/booking-setup.md を参照。秘密値はサーバー環境変数にのみ設定。
GOOGLE_BOOKING_SCRIPT_URL=
GOOGLE_BOOKING_SECRET=

# 任意: 予約を受け付けるHTTPS公開元を明示（末尾の / は付けない）
# 例: https://booking.example。未設定なら同一オリジンを使用。
BOOKING_SITE_ORIGIN=
